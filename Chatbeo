-- SOUND OOF
local function playClick()
    local s = Instance.new("Sound", SoundService)
    s.SoundId = "rbxassetid://12222216" -- oof sound
    s.Volume = 2
    s:Play()
    game.Debris:AddItem(s,2)
end

-- RAINBOW
local function rainbow(obj, speed)
    task.spawn(function()
        local h = 0
        while obj and obj.Parent do
            h += speed or 0.005
            if h > 1 then h = 0 end
            obj.BackgroundColor3 = Color3.fromHSV(h,1,1)
            task.wait(0.01)
        end
    end)
end

