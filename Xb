--// LOAD SCRIPT NGOÀI
loadstring(game:HttpGet("https://raw.githubusercontent.com/gumanba/Scripts/main/SurviveZombieArena"))()

--// SERVICES
local Players = game:GetService("Players")
local lp = Players.LocalPlayer

--// SETTINGS
local enabled = false
local delay = 0.01

--// GUI
local sg = Instance.new("ScreenGui", game.CoreGui)
sg.Name = "BringGUI"

local frame = Instance.new("Frame", sg)
frame.Size = UDim2.new(0, 200, 0, 100)
frame.Position = UDim2.new(0.3, 0, 0.3, 0)
frame.BackgroundColor3 = Color3.fromRGB(25,25,25)
frame.Active = true
frame.Draggable = true

local btn = Instance.new("TextButton", frame)
btn.Size = UDim2.new(1, -20, 0, 40)
btn.Position = UDim2.new(0, 10, 0, 30)
btn.Text = "OFF"
btn.BackgroundColor3 = Color3.fromRGB(200,50,50)
btn.TextColor3 = Color3.new(1,1,1)

btn.MouseButton1Click:Connect(function()
    enabled = not enabled
    btn.Text = enabled and "ON" or "OFF"
    btn.BackgroundColor3 = enabled and Color3.fromRGB(50,200,50) or Color3.fromRGB(200,50,50)
end)

--// BRING FIX
task.spawn(function()
    while true do
        if enabled then
            pcall(function()
                local char = lp.Character
                if not char then return end

                local hrp = char:FindFirstChild("HumanoidRootPart")
                if not hrp then return end

                local folder = workspace:FindFirstChild("VoidShards")
                if not folder then return end

                local i = 0

                for _, v in pairs(folder:GetChildren()) do
                    if v.Name == "VoidShardPart" and v:IsA("BasePart") then
                        
                        -- FIX QUAN TRỌNG
                        v.Anchored = true
                        v.CanCollide = false
                        
                        -- offset xung quanh người (không kéo player)
                        local offset = CFrame.new(
                            math.random(-3,3),
                            math.random(1,3),
                            math.random(-3,3)
                        )

                        v.CFrame = hrp.CFrame * offset
                        
                        i += 1
                    end
                end
            end)
        end
        task.wait(delay)
    end
end)
