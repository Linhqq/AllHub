-- ====================================
-- AUTO FARM GUI
-- 1. Auto Bring (custom amount)
-- 2. Auto Spin (0.2s)
-- 3. Auto Dupe (Radioactive Coin)
-- ====================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

-- ===== CONFIG =====
local BRING = false
local SPIN = false
local DUPE = false

local BRING_DELAY = 0.5
local SPIN_DELAY = 0.2
local DUPE_DELAY = 0.5

local BRING_LIMIT = 10

-- ===== CHARACTER =====
local function getHRP()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("HumanoidRootPart")
end

-- ===== GET COINS =====
local function getAllCoins()
    local coins = {}
    local folder = workspace:FindFirstChild("EventParts", true)
    if folder then
        for _, v in pairs(folder:GetDescendants()) do
            if v:IsA("BasePart") and string.find(string.lower(v.Name), "coin") then
                table.insert(coins, v)
            end
        end
    end
    return coins
end

-- ===== BRING LOOP =====
task.spawn(function()
    while task.wait(BRING_DELAY) do
        if BRING then
            pcall(function()
                local hrp = getHRP()
                local coins = getAllCoins()
                local count = 0
                for _, coin in pairs(coins) do
                    if coin and coin.Parent then
                        coin.Anchored = false
                        coin.CanCollide = false
                        coin.CFrame = hrp.CFrame
                        count += 1
                        if count >= BRING_LIMIT then break end
                    end
                end
            end)
        end
    end
end)

-- ===== AUTO SPIN LOOP =====
task.spawn(function()
    local rf = ReplicatedStorage:WaitForChild("Packages")
        :WaitForChild("Net")
        :WaitForChild("RF/WheelSpin.Roll")

    while task.wait(SPIN_DELAY) do
        if SPIN then
            pcall(function()
                rf:InvokeServer()
            end)
        end
    end
end)

-- ===== AUTO DUPE LOOP =====
task.spawn(function()
    while task.wait(DUPE_DELAY) do
        if DUPE then
            pcall(function()
                local eventParts = workspace:FindFirstChild("EventParts", true)
                if eventParts then
                    for _, item in pairs(eventParts:GetChildren()) do
                        if item.Name == "Radioactive Coin" then
                            local clone = item:Clone()
                            clone.Parent = item.Parent

                            if clone:IsA("Model") and clone.PrimaryPart then
                                clone:SetPrimaryPartCFrame(item:GetPrimaryPartCFrame())
                            elseif clone:IsA("BasePart") then
                                clone.CFrame = item.CFrame
                            end

                            task.wait(0.01)
                        end
                    end
                end
            end)
        end
    end
end)

