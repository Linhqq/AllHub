UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if currentRebinding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local kc = input.KeyCode
            if kc ~= Enum.KeyCode.Unknown then
                keybinds[currentRebinding.mode] = kc
                currentRebinding.button.Text = keycodeToStr(kc)
                currentRebinding = nil
            end
        end
        return
    end

    if gameProcessed then return end
    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end

    local kc = input.KeyCode

    if kc == keybinds.NoAnim then
        toggleNoAnim()
    elseif kc == keybinds.Booster then
        toggleBooster()
    elseif kc == keybinds.Fly then
        toggleFly()
    elseif kc == keybinds.FloatV1 then
        toggleFloatV1()
    elseif kc == keybinds.Quick then
        toggleQuickInteract()
    elseif kc == keybinds.AntiKB then
        toggleAntiKB()
    end
end)
