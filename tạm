local function computeAntiKBVelocity()
    if not (char and hum and hum.RootPart) then
        return Vector3.new(0,0,0)
    end

    local root = hum.RootPart
    local vel  = root.AssemblyLinearVelocity
    local moveDir = hum.MoveDirection

    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local y     = math.clamp(vel.Y, -ANTI_MAX_Y, ANTI_MAX_Y)

    if moveDir.Magnitude > 0.1 then
        -- Giữ chuyển động theo hướng mình đang input, xoá hết lực ngang khác hướng
        local dir = moveDir.Unit
        local forwardMag = horiz:Dot(dir) -- thành phần cùng hướng di chuyển
        local clampedForward = math.clamp(forwardMag, -ANTI_MAX_FORWARD, ANTI_MAX_FORWARD)
        local forwardVec = dir * clampedForward
        return Vector3.new(forwardVec.X, y, forwardVec.Z)
    else
        -- Không bấm phím: cho trôi nhẹ, xoá knockback mạnh
        local mag = horiz.Magnitude
        if mag > ANTI_MAX_IDLE then
            horiz = horiz.Unit * ANTI_MAX_IDLE
        end
        return Vector3.new(horiz.X, y, horiz.Z)
    end
end

local function startAntiKBInternal()
    clearAntiKBConns()
    if not (char and hum and hum.RootPart) then return end

    local root = hum.RootPart

    -- Ép state về Running + dọn ragdoll khi bị knock
    table.insert(antiKBConns, hum.StateChanged:Connect(function(_, newState)
        if not antiKBEnabled then return end
        if newState == Enum.HumanoidStateType.FallingDown
        or newState == Enum.HumanoidStateType.Ragdoll
        or newState == Enum.HumanoidStateType.Physics
        or newState == Enum.HumanoidStateType.PlatformStanding then
            cleanRagdollStuff()
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end))

    -- Chặn impulse knockback từ combat remote nếu có
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local packages = rs:FindFirstChild("Packages")
        if packages and packages:FindFirstChild("Net") then
            local net = packages.Net
            local ev = net:FindFirstChild("RE/CombatService/ApplyImpulse")
            if ev and ev:IsA("RemoteEvent") then
                table.insert(antiKBConns, ev.OnClientEvent:Connect(function()
                    if not antiKBEnabled then return end
                    root.AssemblyLinearVelocity = computeAntiKBVelocity()
                end))
            end
        end
    end)

    -- Nếu game spawn thêm constraint ragdoll thì dọn
    table.insert(antiKBConns, char.DescendantAdded:Connect(function()
        if not antiKBEnabled then return end
        task.defer(cleanRagdollStuff)
    end))

    -- Mỗi frame override velocity -> gần như không ăn knockback
    table.insert(antiKBConns, RunService.Heartbeat:Connect(function()
        if not antiKBEnabled or not (char and hum and hum.RootPart) then return end
        cleanRagdollStuff()
        hum.RootPart.AssemblyLinearVelocity = computeAntiKBVelocity()
    end))

    cleanRagdollStuff()
end

local function stopAntiKBInternal()
    clearAntiKBConns()
end

local function setupChar(c)
    char = c
    hum  = char:WaitForChild("Humanoid")
    hrp  = char:WaitForChild("HumanoidRootPart")

    -- reset flag mỗi lần respawn
    hasDroppedForFloatV1 = false

    if noAnimEnabled then
        applyNoAnim(hum)
    else
        restoreAnim(hum)
    end

    if boosterEnabled then
        applyBooster()
    else
        stopBoosterInternal()
    end

    if antiKBEnabled then
        startAntiKBInternal()
    else
        stopAntiKBInternal()
    end

    refreshGodMode()
end

setupChar(char)
plr.CharacterAdded:Connect(setupChar)

local flySpeed       = 16
local esyncSpeed     = 16
local esyncFallSpeed = 0.5

RunService.Heartbeat:Connect(function(dt)
    if not (char and hum and hum.RootPart) then
        return
    end

    local root = hum.RootPart

    if flyEnabled then
        local cam = Workspace.CurrentCamera
        if not cam then return end

        local look = cam.CFrame.LookVector
        local moveDir = hum.MoveDirection

        local horizontal = Vector3.new(look.X, 0, look.Z)
        if horizontal.Magnitude > 0 then
            horizontal = horizontal.Unit
        end

        local vel = Vector3.new(0, 0, 0)

        if moveDir.Magnitude > 0.1 then
            vel = vel + horizontal * flySpeed
        end

        if look.Y > 0.25 then
            vel = vel + Vector3.new(0, flySpeed, 0)
        elseif look.Y < -0.25 then
            vel = vel + Vector3.new(0, -flySpeed, 0)
        end

        root.AssemblyLinearVelocity = vel

        local flatVel = Vector3.new(vel.X, 0, vel.Z)
        if flatVel.Magnitude > 1 then
            root.CFrame = CFrame.new(root.Position, root.Position + flatVel)
        end

        return
    end

    if esyncEnabled then
        local cam = Workspace.CurrentCamera
        if not cam then return end

        local look = cam.CFrame.LookVector
        local moveDir = hum.MoveDirection

        local horizontal = Vector3.new(look.X, 0, look.Z)
        if horizontal.Magnitude > 0 then
            horizontal = horizontal.Unit
        else
            horizontal = Vector3.new(0,0,0)
        end

        local driftFactor = 1.3
        local horizVel = Vector3.new(0,0,0)
        if moveDir.Magnitude > 0.1 then
            horizVel = horizontal * esyncSpeed * driftFactor
        end

        local vel = horizVel + Vector3.new(0, -esyncFallSpeed, 0)
        root.AssemblyLinearVelocity = vel
        return
    end
end)

local function getPromptPos(prompt)
    if not prompt or not prompt.Parent then return nil end
    local parent = prompt.Parent

    if parent:IsA("BasePart") then
        return parent.Position
    elseif parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("Model") and parent.PrimaryPart then
        return parent.PrimaryPart.Position
    end
    return nil
end

local function toggleQuickInteract()
    quickInteract = not quickInteract

    quickBtn.Text = "QuickInteract: " .. (quickInteract and "ON" or "OFF")
    quickBtn.BackgroundColor3 = quickInteract and Color3.fromRGB(0,200,130) or Color3.fromRGB(120,0,0)

    if not quickInteract then
        if quickThread then
            pcall(function()
                task.cancel(quickThread)
            end)
            quickThread = nil
        end

        for p,hold in pairs(originalHold) do
            if p and p:IsA("ProximityPrompt") then
                p.HoldDuration = hold
            end
        end
        originalHold = {}
        return
    end

    quickThread = task.spawn(function()
        while quickInteract do
            task.wait(0.15)

            if not hrp or not hrp.Parent then
                -- skip
            else
                local prompts = Workspace:GetDescendants()
                for i = 1, #prompts do
                    local v = prompts[i]
                    if v:IsA("ProximityPrompt") and v.Enabled then
                        if originalHold[v] == nil then
                            originalHold[v] = v.HoldDuration
                        end

                        v.HoldDuration = 0

                        local pos = getPromptPos(v)
                        if pos then
                            local dist = (hrp.Position - pos).Magnitude
                            if dist <= 10 then
                                pcall(function()
                                    fireproximityprompt(v)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

local function stopAllModes()
    flyEnabled    = false
    esyncEnabled  = false

    flyBtn.Text = "Fly: OFF"
    flyBtn.BackgroundColor3 = Color3.fromRGB(120,0,0)

    esyncBtn.Text = "FloatV1: OFF"
    esyncBtn.BackgroundColor3 = Color3.fromRGB(120,0,0)

    if hum and hum.RootPart then
        hum.RootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
    end
end

local function toggleNoAnim()
    noAnimEnabled = not noAnimEnabled
    noAnimBtn.Text = "NoAnim: " .. (noAnimEnabled and "ON" or "OFF")
    noAnimBtn.BackgroundColor3 = noAnimEnabled and Color3.fromRGB(0,200,130) or Color3.fromRGB(120,0,0)

    if hum then
