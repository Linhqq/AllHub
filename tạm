        stopAllModes()
        flyEnabled = true
        flyBtn.Text = "Fly: ON"
        flyBtn.BackgroundColor3 = Color3.fromRGB(0,200,130)
    else
        flyEnabled = false
        flyBtn.Text = "Fly: OFF"
        flyBtn.BackgroundColor3 = Color3.fromRGB(120,0,0)

        if hum and hum.RootPart then
            hum.RootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end
    end
    refreshGodMode()
end

-- 🔹 Auto drop 3 tool cho FloatV1 (y chang script bạn gửi)
local function autoDropForFloatV1(callback)
    if droppingForFloat or hasDroppedForFloatV1 then
        if callback then callback() end
        return
    end
    droppingForFloat = true

    task.spawn(function()
        local lp = plr
        local c = lp.Character
        local backpack = lp:FindFirstChild("Backpack")

        if c and backpack then
            for _, name in ipairs(floatToolsOrder) do
                local tool = backpack:FindFirstChild(name) or c:FindFirstChild(name)
                if tool and tool:IsA("Tool") then
                    if tool.Parent == backpack then
                        tool.Parent = c
                        task.wait(0.1)
                    end

                    local held = c:FindFirstChildOfClass("Tool")
                    if held then
                        held.Parent = Workspace
                    end
                end
                task.wait(0.1)
            end
        end

        droppingForFloat = false
        hasDroppedForFloatV1 = true

        if callback then
            callback()
        end
    end)
end

local function toggleFloatV1()
    if not esyncEnabled then
        stopAllModes()

        if not hasDroppedForFloatV1 then
            esyncBtn.Text = "FloatV1: DROP..."
            esyncBtn.BackgroundColor3 = Color3.fromRGB(255,170,0)

            autoDropForFloatV1(function()
                if esyncEnabled then return end
                esyncEnabled = true
                esyncBtn.Text = "FloatV1: ON"
                esyncBtn.BackgroundColor3 = Color3.fromRGB(0,200,130)
                refreshGodMode()
            end)
        else
            esyncEnabled = true
            esyncBtn.Text = "FloatV1: ON"
            esyncBtn.BackgroundColor3 = Color3.fromRGB(0,200,130)
            refreshGodMode()
        end
    else
        esyncEnabled = false
        esyncBtn.Text = "FloatV1: OFF"
        esyncBtn.BackgroundColor3 = Color3.fromRGB(120,0,0)

        if hum and hum.RootPart then
            hum.RootPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
        end
        refreshGodMode()
    end
end

local function toggleAntiKB()
    antiKBEnabled = not antiKBEnabled
    antiKBBtn.Text = "AntiKB: " .. (antiKBEnabled and "ON" or "OFF")
    antiKBBtn.BackgroundColor3 = antiKBEnabled and Color3.fromRGB(0,200,130) or Color3.fromRGB(120,0,0)

    if antiKBEnabled then
        startAntiKBInternal()
    else
