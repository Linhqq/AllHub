-- Helper tạo vector đúng kiểu game dùng
local function makeVec(x, y, z)
    if typeof(vector) == "table" and typeof(vector.create) == "function" then
        return vector.create(x, y, z)
    else
        return Vector3.new(x, y, z)
    end
end

