local function HookTool(tool)
    if not tool:IsA("Tool") then return end

    -- Nếu là Pantball thì bind giữ equip cho auto
    if IsPantballTool(tool) then
        BindPantball(tool)
    end

    -- Bất kỳ tool nào click cũng bắn theo FireOnce (aim chân)
    tool.Activated:Connect(function()
        FireOnce()
    end)
end

for _, child in ipairs(char:GetChildren()) do
