local humanoidAnimConn

local function applyNoAnim(humanoid)
    local animate = humanoid.Parent:FindFirstChild("Animate")
    if animate then
        animate.Disabled = true
    end

    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
        track:Stop()
    end

    if humanoidAnimConn then
        humanoidAnimConn:Disconnect()
    end

    humanoidAnimConn = humanoid.AnimationPlayed:Connect(function(track)
        if noAnimEnabled then
            task.wait()
            track:Stop()
        end
    end)
end

local function restoreAnim(humanoid)
    local animate = humanoid.Parent:FindFirstChild("Animate")
    if animate then
        animate.Disabled = false
    end

    if humanoidAnimConn then
        humanoidAnimConn:Disconnect()
        humanoidAnimConn = nil
    end
end

-- 🔹 Booster (chỉ chạy nhanh, không buff nhảy / gravity)
local BOOST_SPEED = 27
local boosterMoveConn

local function stopBoosterInternal()
    if boosterMoveConn then
        boosterMoveConn:Disconnect()
        boosterMoveConn = nil
    end
end

local function applyBooster()
    stopBoosterInternal()
    if not boosterEnabled or not (char and hum and hum.RootPart) then return end

    boosterMoveConn = RunService.Heartbeat:Connect(function()
        if not boosterEnabled or not (char and hum and hum.RootPart) then return end
        if flyEnabled or esyncEnabled then return end
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            local root = hum.RootPart
            local vel = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(
                moveDir.X * BOOST_SPEED,
                vel.Y,
                moveDir.Z * BOOST_SPEED
            )
        end
    end)
end

-- 🔹 AntiKB mới
local antiKBConns = {}

local function clearAntiKBConns()
    for _, c in ipairs(antiKBConns) do
        pcall(function() c:Disconnect() end)
    end
    antiKBConns = {}
end

local function cleanRagdollStuff()
    if not (char and hum) then return end
    local c = char
    local animator = hum:FindFirstChildOfClass("Animator")

    for _, obj in ipairs(c:GetDescendants()) do
        if obj:IsA("BallSocketConstraint")
        or obj:IsA("NoCollisionConstraint")
        or obj:IsA("HingeConstraint") then
            obj:Destroy()
        elseif obj:IsA("Attachment") and (obj.Name == "A" or obj.Name == "B") then
            obj:Destroy()
        elseif obj:IsA("BodyVelocity")
        or obj:IsA("BodyPosition")
        or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    for _, m in ipairs(c:GetDescendants()) do
        if m:IsA("Motor6D") then
            m.Enabled = true
        end
    end

    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local name = (track.Animation and track.Animation.Name or ""):lower()
            if name:find("rag") or name:find("fall") or name:find("hurt") or name:find("down") then
                track:Stop(0)
            end
        end
    end
end

local ANTI_MAX_FORWARD = 22   -- tốc độ tối đa theo hướng bạn đang chạy
local ANTI_MAX_IDLE    = 8    -- nếu không bấm phím, cho trôi nhẹ thôi
local ANTI_MAX_Y       = 25   -- clamp lực văng lên/xuống

local function computeAntiKBVelocity()
    if not (char and hum and hum.RootPart) then
        return Vector3.new(0,0,0)
    end

    local root = hum.RootPart
    local vel  = root.AssemblyLinearVelocity
    local moveDir = hum.MoveDirection

    local horiz = Vector3.new(vel.X, 0, vel.Z)
    local y     = math.clamp(vel.Y, -ANTI_MAX_Y, ANTI_MAX_Y)

    if moveDir.Magnitude > 0.1 then
        -- Giữ chuyển động theo hướng mình đang input, xoá hết lực ngang khác hướng
        local dir = moveDir.Unit
        local forwardMag = horiz:Dot(dir) -- thành phần cùng hướng di chuyển
        local clampedForward = math.clamp(forwardMag, -ANTI_MAX_FORWARD, ANTI_MAX_FORWARD)
        local forwardVec = dir * clampedForward
        return Vector3.new(forwardVec.X, y, forwardVec.Z)
    else
        -- Không bấm phím: cho trôi nhẹ, xoá knockback mạnh
        local mag = horiz.Magnitude
        if mag > ANTI_MAX_IDLE then
            horiz = horiz.Unit * ANTI_MAX_IDLE
        end
        return Vector3.new(horiz.X, y, horiz.Z)
    end
end

local function startAntiKBInternal()
    clearAntiKBConns()
    if not (char and hum and hum.RootPart) then return end

    local root = hum.RootPart

    -- Ép state về Running + dọn ragdoll khi bị knock
    table.insert(antiKBConns, hum.StateChanged:Connect(function(_, newState)
        if not antiKBEnabled then return end
        if newState == Enum.HumanoidStateType.FallingDown
        or newState == Enum.HumanoidStateType.Ragdoll
        or newState == Enum.HumanoidStateType.Physics
        or newState == Enum.HumanoidStateType.PlatformStanding then
            cleanRagdollStuff()
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end
    end))

    -- Chặn impulse knockback từ combat remote nếu có
    pcall(function()
        local rs = game:GetService("ReplicatedStorage")
        local packages = rs:FindFirstChild("Packages")
        if packages and packages:FindFirstChild("Net") then
            local net = packages.Net
            local ev = net:FindFirstChild("RE/CombatService/ApplyImpulse")
            if ev and ev:IsA("RemoteEvent") then
                table.insert(antiKBConns, ev.OnClientEvent:Connect(function()
                    if not antiKBEnabled then return end
                    root.AssemblyLinearVelocity = computeAntiKBVelocity()
                end))
            end
        end
    end)

    -- Nếu game spawn thêm constraint ragdoll thì dọn
    table.insert(antiKBConns, char.DescendantAdded:Connect(function()
        if not antiKBEnabled then return end
        task.defer(cleanRagdollStuff)
    end))

    -- Mỗi frame override velocity -> gần như không ăn knockback
    table.insert(antiKBConns, RunService.Heartbeat:Connect(function()
        if not antiKBEnabled or not (char and hum and hum.RootPart) then return end
        cleanRagdollStuff()
        hum.RootPart.AssemblyLinearVelocity = computeAntiKBVelocity()
    end))

    cleanRagdollStuff()
end

local function stopAntiKBInternal()
    clearAntiKBConns()
end

local function setupChar(c)
    char = c
    hum  = char:WaitForChild("Humanoid")
    hrp  = char:WaitForChild("HumanoidRootPart")

    -- reset flag mỗi lần respawn
    hasDroppedForFloatV1 = false

    if noAnimEnabled then
        applyNoAnim(hum)
    else
        restoreAnim(hum)
    end

    if boosterEnabled then
        applyBooster()
    else
        stopBoosterInternal()
    end

    if antiKBEnabled then
        startAntiKBInternal()
    else
        stopAntiKBInternal()
    end

    refreshGodMode()
end

