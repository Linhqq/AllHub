local function cleanRagdollStuff()
    if not (char and hum) then return end
    local c = char
    local animator = hum:FindFirstChildOfClass("Animator")

    for _, obj in ipairs(c:GetDescendants()) do
        if obj:IsA("BallSocketConstraint")
        or obj:IsA("NoCollisionConstraint")
        or obj:IsA("HingeConstraint") then
            obj:Destroy()
        elseif obj:IsA("Attachment") and (obj.Name == "A" or obj.Name == "B") then
            obj:Destroy()
        elseif obj:IsA("BodyVelocity")
        or obj:IsA("BodyPosition")
        or obj:IsA("BodyGyro") then
            obj:Destroy()
        end
    end

    for _, m in ipairs(c:GetDescendants()) do
        if m:IsA("Motor6D") then
            m.Enabled = true
        end
    end

    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local name = (track.Animation and track.Animation.Name or ""):lower()
            if name:find("rag") or name:find("fall") or name:find("hurt") or name:find("down") then
                track:Stop(0)
            end
        end
    end
end

