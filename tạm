local function FireOnce()
    local myChar = char
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not (myChar and hum and myRoot) then return end

    -- ❗ CHỈ AUTO EQUIP PANTBALL KHI GUN ĐANG ON
    if autoEnabled then
        if not PantballTool or PantballTool.Parent == nil then
            FindAndEquipPantball()
        end
    end

    local pos

    if aimEnabled then
        local targetPlayer, targetPart = GetNearestPlayer()
        PB_CurrentTarget = targetPlayer
        UpdateButtons()
        if targetPart then
            pos = targetPart.Position
        end
    end

    if not pos then
        pos = myRoot.Position + myRoot.CFrame.LookVector * 10
    end

    -- 🔫 Pantball / UseItem
    if REUseItem then
        pcall(function()
            REUseItem:FireServer(pos)
        end)
    end

    -- 🔫 LaserGun_Fire cùng aim
    if RELaserGun then
        local dir = (pos - myRoot.Position)
        if dir.Magnitude == 0 then
            dir = myRoot.CFrame.LookVector
        else
            dir = dir.Unit
        end

        local vPos = makeVec(pos.X, pos.Y, pos.Z)
        local vDir = makeVec(dir.X, dir.Y, dir.Z)

        pcall(function()
            RELaserGun:FireServer(LASER_ID, vPos, vDir, tick())
        end)
    end

    PB_LastFireTime = tick()
end

--------------------------------------------------
-- AUTO GUN LOOP (0.20s) + EQUIP LASER 3s
--------------------------------------------------
local function StopAutoLoop()
    if autoConn then
        autoConn:Disconnect()
        autoConn = nil
    end
    PB_FireAccum = 0
    LaserTimer   = 0
end

local function StartAutoLoop()
    StopAutoLoop()
    if not autoEnabled then return end

    PB_FireAccum    = 0
    PB_LastFireTime = tick()
    LaserTimer      = 0

    FindAndEquipPantball()

    autoConn = RunService.Heartbeat:Connect(function(dt)
        if not autoEnabled then return end
        if not (char and hum and hum.RootPart) then return end

        PB_FireAccum = PB_FireAccum + dt
        if PB_FireAccum >= 0.20 then
            PB_FireAccum = 0
            FireOnce()
        end

        if (tick() - PB_LastFireTime) >= 3 then
            FireOnce()
        end

        -- 🔥 EQUIP LASER GUN MỖI 3s (kích hoạt skill của súng)
        LaserTimer = LaserTimer + dt
        if LaserTimer >= 3 then
            LaserTimer = 0
            local laser = FindLaserGun()
            if laser and hum then
                pcall(function()
                    hum:EquipTool(laser)
                    laser:Activate()
                end)
                -- Sau đó listener Pantball sẽ kéo Pantball lại tay nếu autoEnabled
            end
        end
    end)
end

