local flySpeed       = 16
local esyncSpeed     = 16
local esyncFallSpeed = 0.5

RunService.Heartbeat:Connect(function(dt)
    if not (char and hum and hum.RootPart) then
        return
    end

    local root = hum.RootPart

    if flyEnabled then
        local cam = Workspace.CurrentCamera
        if not cam then return end

        local look = cam.CFrame.LookVector
        local moveDir = hum.MoveDirection

        local horizontal = Vector3.new(look.X, 0, look.Z)
        if horizontal.Magnitude > 0 then
            horizontal = horizontal.Unit
        end

        local vel = Vector3.new(0, 0, 0)

        if moveDir.Magnitude > 0.1 then
            vel = vel + horizontal * flySpeed
        end

        if look.Y > 0.25 then
            vel = vel + Vector3.new(0, flySpeed, 0)
        elseif look.Y < -0.25 then
            vel = vel + Vector3.new(0, -flySpeed, 0)
        end

        root.AssemblyLinearVelocity = vel

        local flatVel = Vector3.new(vel.X, 0, vel.Z)
        if flatVel.Magnitude > 1 then
            root.CFrame = CFrame.new(root.Position, root.Position + flatVel)
        end

        return
    end

    if esyncEnabled then
        local cam = Workspace.CurrentCamera
        if not cam then return end

        local look = cam.CFrame.LookVector
        local moveDir = hum.MoveDirection

        local horizontal = Vector3.new(look.X, 0, look.Z)
        if horizontal.Magnitude > 0 then
            horizontal = horizontal.Unit
        else
            horizontal = Vector3.new(0,0,0)
        end

        local driftFactor = 1.3
        local horizVel = Vector3.new(0,0,0)
        if moveDir.Magnitude > 0.1 then
            horizVel = horizontal * esyncSpeed * driftFactor
        end

        local vel = horizVel + Vector3.new(0, -esyncFallSpeed, 0)
        root.AssemblyLinearVelocity = vel
        return
    end
end)

local function getPromptPos(prompt)
    if not prompt or not prompt.Parent then return nil end
    local parent = prompt.Parent

    if parent:IsA("BasePart") then
        return parent.Position
    elseif parent:IsA("Attachment") then
        return parent.WorldPosition
    elseif parent:IsA("Model") and parent.PrimaryPart then
        return parent.PrimaryPart.Position
    end
    return nil
end

local function toggleQuickInteract()
    quickInteract = not quickInteract

    quickBtn.Text = "QuickInteract: " .. (quickInteract and "ON" or "OFF")
    quickBtn.BackgroundColor3 = quickInteract and Color3.fromRGB(0,200,130) or Color3.fromRGB(120,0,0)

    if not quickInteract then
        if quickThread then
            pcall(function()
                task.cancel(quickThread)
            end)
            quickThread = nil
        end

        for p,hold in pairs(originalHold) do
            if p and p:IsA("ProximityPrompt") then
                p.HoldDuration = hold
            end
        end
        originalHold = {}
        return
    end

    quickThread = task.spawn(function()
        while quickInteract do
            task.wait(0.15)

            if not hrp or not hrp.Parent then
                -- skip
            else
                local prompts = Workspace:GetDescendants()
                for i = 1, #prompts do
                    local v = prompts[i]
                    if v:IsA("ProximityPrompt") and v.Enabled then
                        if originalHold[v] == nil then
                            originalHold[v] = v.HoldDuration
                        end

                        v.HoldDuration = 0

                        local pos = getPromptPos(v)
                        if pos then
                            local dist = (hrp.Position - pos).Magnitude
                            if dist <= 10 then
                                pcall(function()
                                    fireproximityprompt(v)
                                end)
                            end
                        end
                    end
                end
            end
        end
    end)
end

