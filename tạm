local humanoidAnimConn

local function applyNoAnim(humanoid)
    local animate = humanoid.Parent:FindFirstChild("Animate")
    if animate then
        animate.Disabled = true
    end

    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
        track:Stop()
    end

    if humanoidAnimConn then
        humanoidAnimConn:Disconnect()
    end

    humanoidAnimConn = humanoid.AnimationPlayed:Connect(function(track)
        if noAnimEnabled then
            task.wait()
            track:Stop()
        end
    end)
end

local function restoreAnim(humanoid)
    local animate = humanoid.Parent:FindFirstChild("Animate")
    if animate then
        animate.Disabled = false
    end

    if humanoidAnimConn then
        humanoidAnimConn:Disconnect()
        humanoidAnimConn = nil
    end
end

-- 🔹 Booster (chỉ chạy nhanh, không buff nhảy / gravity)
local BOOST_SPEED = 27
local boosterMoveConn

local function stopBoosterInternal()
    if boosterMoveConn then
        boosterMoveConn:Disconnect()
        boosterMoveConn = nil
    end
end

local function applyBooster()
    stopBoosterInternal()
    if not boosterEnabled or not (char and hum and hum.RootPart) then return end

    boosterMoveConn = RunService.Heartbeat:Connect(function()
        if not boosterEnabled or not (char and hum and hum.RootPart) then return end
        if flyEnabled or esyncEnabled then return end
        local moveDir = hum.MoveDirection
        if moveDir.Magnitude > 0 then
            local root = hum.RootPart
            local vel = root.AssemblyLinearVelocity
            root.AssemblyLinearVelocity = Vector3.new(
                moveDir.X * BOOST_SPEED,
                vel.Y,
                moveDir.Z * BOOST_SPEED
            )
        end
    end)
end

