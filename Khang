-- TÌM LASER GUN (KO BIND)
--------------------------------------------------
local function FindLaserGun()
    if not (char and hum) then return nil end
    local backpack = plr:FindFirstChild("Backpack")
    local found

    for _, name in ipairs(LASER_NAMES) do
        local t = char:FindFirstChild(name)
        if t and t:IsA("Tool") then
            found = t
            break
        end
    end

    if not found and backpack then
        for _, name in ipairs(LASER_NAMES) do
            local t = backpack:FindFirstChild(name)
            if t and t:IsA("Tool") then
                found = t
                break
            end
        end
    end

    return found
end

