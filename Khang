--------------------------------------------------
-- BEAM
--------------------------------------------------
local function DestroyLine()
    if PB_LineBeam then PB_LineBeam:Destroy() PB_LineBeam = nil end
    if PB_LocalAttachment then PB_LocalAttachment:Destroy() PB_LocalAttachment = nil end
    if PB_TargetAttachment then PB_TargetAttachment:Destroy() PB_TargetAttachment = nil end
end

local function EnsureLine(localRoot, targetPart)
    if not localRoot or not targetPart or not aimEnabled then
        if PB_LineBeam then PB_LineBeam.Enabled = false end
        return
    end

    if not PB_LocalAttachment or PB_LocalAttachment.Parent ~= localRoot then
        if PB_LocalAttachment then PB_LocalAttachment:Destroy() end
        PB_LocalAttachment = Instance.new("Attachment")
        PB_LocalAttachment.Name = "PB_LocalAttach"
        PB_LocalAttachment.Parent = localRoot
    end

    if not PB_TargetAttachment or PB_TargetAttachment.Parent ~= targetPart then
        if PB_TargetAttachment then PB_TargetAttachment:Destroy() end
        PB_TargetAttachment = Instance.new("Attachment")
        PB_TargetAttachment.Name = "PB_TargetAttach"
        PB_TargetAttachment.Parent = targetPart
    end

    if not PB_LineBeam or not PB_LineBeam.Parent then
        PB_LineBeam = Instance.new("Beam")
        PB_LineBeam.Name = "PB_RedLine"
        PB_LineBeam.Attachment0 = PB_LocalAttachment
        PB_LineBeam.Attachment1 = PB_TargetAttachment
        PB_LineBeam.FaceCamera = false
        PB_LineBeam.Width0 = 0.1
        PB_LineBeam.Width1 = 0.1
        PB_LineBeam.Color = ColorSequence.new(Color3.fromRGB(255,0,0))
        PB_LineBeam.Transparency = NumberSequence.new(0)
        PB_LineBeam.Parent = Workspace
    else
        PB_LineBeam.Attachment0 = PB_LocalAttachment
        PB_LineBeam.Attachment1 = PB_TargetAttachment
    end

    PB_LineBeam.Enabled = true
end

