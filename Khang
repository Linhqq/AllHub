    "Pantball Gun",
    "Paintball Gun",
}

local LASER_NAMES = {
    "Laser Gun",
}

-- 👉 Remote bắn Pantball + Laser
local REUseItem      -- Pantball: RE/UseItem(pos)
local RELaserGun     -- Laser:   RE/LaserGun_Fire(id, posVec, dirVec, time)

pcall(function()
    local packages = ReplicatedStorage:WaitForChild("Packages")
    local net      = packages:WaitForChild("Net")
    REUseItem      = net:FindFirstChild("RE/UseItem")
    RELaserGun     = net:FindFirstChild("RE/LaserGun_Fire")
end)

-- ID Laser lấy từ log
local LASER_ID = "96f1c234fdf04bdd8bf9fa21991bb745"

-- Helper tạo vector đúng kiểu game dùng
local function makeVec(x, y, z)
    if typeof(vector) == "table" and typeof(vector.create) == "function" then
        return vector.create(x, y, z)
    else
        return Vector3.new(x, y, z)
    end
end

-- STATE
local aimEnabled          = true   -- Aim ON mặc định
local autoEnabled         = false  -- Auto OFF mặc định
local autoConn            = nil
local PB_CurrentTarget    = nil
local PB_LineBeam         = nil
local PB_LocalAttachment  = nil
local PB_TargetAttachment = nil
local PB_FireAccum        = 0
local PB_LastFireTime     = 0

-- giữ Pantball Gun cho auto
local PantballTool = nil
local PantConn     = nil
local LAST_EQUIP_PANT   = 0
local EQUIP_DELAY_PANT  = 0.05  -- 0.05s re-equip

-- Laser equip mỗi 3s
local LaserTimer = 0

--------------------------------------------------
-- GIỮ PANTBALL GUN (CHỈ KHI GUN ON)
--------------------------------------------------
local function UnbindPantball()
    if PantConn then
        PantConn:Disconnect()
        PantConn = nil
    end
    PantballTool = nil
end

local function SafeEquipPant(tool)
    if not (char and hum and tool) then return end

    local now = tick()
    if now - LAST_EQUIP_PANT < EQUIP_DELAY_PANT then
        return
    end
    LAST_EQUIP_PANT = now

    task.defer(function()
        pcall(function()
            hum:EquipTool(tool)
        end)
    end)
end

local function IsPantballTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    for _, name in ipairs(PANTBALL_NAMES) do
        if tool.Name == name then
            return true
        end
    end
    return false
end

local function BindPantball(tool)
    UnbindPantball()
    PantballTool = tool
    if not tool then return end

    -- 🔥 CHỈ RE-EQUIP KHI GUN ĐANG ON
    PantConn = tool:GetPropertyChangedSignal("Parent"):Connect(function()
        if not autoEnabled then
            return -- aim-only thì kệ, không ép equip
        end
        if tool.Parent ~= char then
            SafeEquipPant(tool)
        end
    end)
end

local function FindAndEquipPantball()
    if not (char and hum) then
        UnbindPantball()
        return nil
    end

    local backpack = plr:FindFirstChild("Backpack")
    local found

    -- ưu tiên đang cầm
    for _, name in ipairs(PANTBALL_NAMES) do
        local t = char:FindFirstChild(name)
        if t and t:IsA("Tool") then
            found = t
            break
        end
    end

    -- nếu không thì tìm trong backpack
    if not found and backpack then
        for _, name in ipairs(PANTBALL_NAMES) do
            local t = backpack:FindFirstChild(name)
            if t and t:IsA("Tool") then
                found = t
                break
            end
        end
    end

    if found then
        SafeEquipPant(found)
        BindPantball(found)
        return found
    else
        UnbindPantball()
        return nil
    end
end

-- chỉ bảo kê Pantball khi GUN đang ON
RunService.Heartbeat:Connect(function()
    if autoEnabled and PantballTool and PantballTool.Parent ~= char then
        SafeEquipPant(PantballTool)
    end
end)

